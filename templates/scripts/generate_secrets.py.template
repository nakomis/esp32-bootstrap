    secrets_file = project_root / "include" / "secrets.h"
    secrets_file.write_text(secrets_content)

    print(f"  Written: {secrets_file}")
    print()
    print("=" * 60)
    print("  Secrets generated successfully!")
    print("=" * 60)
    print()
    print("IMPORTANT: Do not commit secrets.h to git!")
    print("The .gitignore should already exclude it.")


if __name__ == "__main__":
    main()
