#!/usr/bin/env python3
"""
{{ PROJECT_NAME_PASCAL }} - Generate Secrets Script
Fetches IoT certificates and WiFi credentials from AWS SSM Parameter Store
and generates the secrets.h file.
"""

import os
import sys
from pathlib import Path
import boto3
from botocore.exceptions import ClientError

# Configuration
PROJECT_NAME = "{{ PROJECT_NAME_PASCAL }}"
THING_NAME = f"{PROJECT_NAME}Thing"
SSM_PREFIX = f"/{PROJECT_NAME}/{THING_NAME}"

# WiFi credentials are stored at a common location
WIFI_SSM_PREFIX = "/Nakomis/Wifi"


def get_ssm_parameter(ssm_client, name: str, decrypt: bool = True) -> str:
    """Fetch a parameter from SSM Parameter Store."""
    try:
        response = ssm_client.get_parameter(Name=name, WithDecryption=decrypt)
        return response['Parameter']['Value']
    except ClientError as e:
        if e.response['Error']['Code'] == 'ParameterNotFound':
            return None
        raise


def get_iot_endpoints(iot_client) -> tuple:
    """Get IoT data and credentials endpoints."""
    # Data endpoint
    data_response = iot_client.describe_endpoint(endpointType='iot:Data-ATS')
    data_endpoint = data_response['endpointAddress']

    # Credentials endpoint
    creds_response = iot_client.describe_endpoint(endpointType='iot:CredentialProvider')
    creds_endpoint = creds_response['endpointAddress']

    return data_endpoint, creds_endpoint


def generate_secrets_h(
    cert_pem: str,
    private_key: str,
    ca_cert: str,
    wifi_ssid: str,
    wifi_password: str,
    iot_endpoint: str,
    credentials_endpoint: str
) -> str:
    """Generate the contents of secrets.h"""

    return f'''/**
 * secrets.h - WiFi and AWS IoT credentials
 *
 * AUTO-GENERATED by generate_secrets.py
 * DO NOT COMMIT THIS FILE TO GIT!
 *
 * Regenerate by running:
 *   python scripts/generate_secrets.py
 */

#ifndef SECRETS_H
#define SECRETS_H

// WiFi credentials (can also be set via BLE)
#define WIFI_SSID "{wifi_ssid}"
#define WIFI_PASSWORD "{wifi_password}"

// AWS IoT endpoint
#define AWS_IOT_ENDPOINT "{iot_endpoint}"

// AWS IoT credentials provider endpoint
#define AWS_CREDENTIALS_ENDPOINT "{credentials_endpoint}"

// IoT Thing name
#define AWS_IOT_THING_NAME "{THING_NAME}"

// Role alias for credentials provider
#define AWS_IOT_ROLE_ALIAS "{PROJECT_NAME}RoleAlias"

// Certificate (PEM format)
static const char AWS_CERT_CRT[] PROGMEM = R"EOF(
{cert_pem})EOF";

// Private key (PEM format)
static const char AWS_CERT_PRIVATE[] PROGMEM = R"EOF(
{private_key})EOF";

// Amazon Root CA 1
static const char AWS_CERT_CA[] PROGMEM = R"EOF(
{ca_cert})EOF";

#endif // SECRETS_H
'''


def main():
    print("=" * 60)
    print(f"  {PROJECT_NAME} - Generate Secrets")
    print("=" * 60)
    print()

    # Check AWS profile
    aws_profile = os.environ.get('AWS_PROFILE')
    if not aws_profile:
        print("Warning: AWS_PROFILE not set")
        aws_profile = input("Enter AWS profile name: ").strip()
        if not aws_profile:
            print("No profile provided. Exiting.")
            sys.exit(1)
        os.environ['AWS_PROFILE'] = aws_profile

    print(f"AWS Profile: {aws_profile}")
    print()

    # Initialize AWS clients
    session = boto3.Session()
    ssm_client = session.client('ssm')
    iot_client = session.client('iot')

    # Fetch certificate and private key from SSM
    print("Fetching IoT credentials from SSM...")
    cert_pem = get_ssm_parameter(ssm_client, f"{SSM_PREFIX}/certPem")
    private_key = get_ssm_parameter(ssm_client, f"{SSM_PREFIX}/privKey")

    if not cert_pem or not private_key:
        print(f"Error: Could not find IoT credentials in SSM")
        print(f"  Expected: {SSM_PREFIX}/certPem")
        print(f"  Expected: {SSM_PREFIX}/privKey")
        print()
        print("Have you deployed the CDK stack?")
        print("  cd infra && cdk deploy")
        sys.exit(1)

    print("  Certificate: OK")
    print("  Private Key: OK")

    # Fetch WiFi credentials (optional)
    print()
    print("Fetching WiFi credentials from SSM...")
    wifi_ssid = get_ssm_parameter(ssm_client, f"{WIFI_SSM_PREFIX}/SSID")
    wifi_password = get_ssm_parameter(ssm_client, f"{WIFI_SSM_PREFIX}/Password")

    if wifi_ssid and wifi_password:
        print(f"  SSID: {wifi_ssid}")
        print("  Password: OK")
    else:
        print("  WiFi credentials not found (can be configured via BLE)")
        wifi_ssid = ""
        wifi_password = ""

    # Get IoT endpoints
    print()
    print("Fetching IoT endpoints...")
    iot_endpoint, credentials_endpoint = get_iot_endpoints(iot_client)
    print(f"  IoT Endpoint: {iot_endpoint}")
    print(f"  Credentials Endpoint: {credentials_endpoint}")

