/**
 * {{ PROJECT_NAME_PASCAL }} - Main Application
 *
 * ESP32-S3-WROOM N16R8 CAM
 * - 16MB Flash, 8MB PSRAM
 * - SD Card (4-bit SDMMC)
 * - BLE for configuration and OTA
 */

#include <Arduino.h>
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

// Project libraries
#include "SDLogger.h"
#include "WifiConnect.h"
#include "WifiBleService.h"
#include "OTAUpdate.h"
#include "OTABleService.h"

// Project configuration
#include "version.h"
#include "secrets.h"

// SD Card pins (ESP32-S3-CAM)
#define SD_CLK  39
#define SD_CMD  38
#define SD_D0   40
#define SD_D1   41
#define SD_D2   42
#define SD_D3   1

// Global instances
SDLogger logger;
WifiConnect wifi;
OTAUpdate otaUpdate;

// BLE server and services
BLEServer* pServer = nullptr;
WifiBleService wifiBleService;
OTABleService otaBleService;

// Connection tracking
bool deviceConnected = false;
bool oldDeviceConnected = false;

// BLE Server callbacks
class ServerCallbacks : public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) override {
        deviceConnected = true;
        logger.log("BLE client connected");
    }

    void onDisconnect(BLEServer* pServer) override {
        deviceConnected = false;
        logger.log("BLE client disconnected");
    }
};

void initSDCard() {
    logger.log("Initializing SD card...");

    // Configure SD card pins
    pinMode(SD_D3, INPUT_PULLUP);  // Card detect

    if (!logger.begin(SD_CLK, SD_CMD, SD_D0, SD_D1, SD_D2, SD_D3)) {
        Serial.println("SD card initialization failed!");
        return;
    }

    logger.log("SD card initialized successfully");
    logger.log("Starting {{ PROJECT_NAME_PASCAL }} %s", FIRMWARE_VERSION);
}

void initBLE() {
    logger.log("Initializing BLE...");

    // Initialize BLE with project name
    BLEDevice::init(PROJECT_NAME);

    // Create BLE server
    pServer = BLEDevice::createServer();
    pServer->setCallbacks(new ServerCallbacks());

    // Initialize WiFi BLE service (provides BLE commands for WiFi config)
    wifiBleService.setWifi(&wifi);
    wifiBleService.init(pServer);

    // Initialize OTA BLE service (provides BLE commands for OTA updates)
    otaBleService.setOTAUpdate(&otaUpdate);
    otaBleService.setWifi(&wifi);
    otaBleService.setVersionString(FIRMWARE_VERSION);
    otaBleService.init(pServer);

    // Start advertising
    BLEAdvertising* pAdvertising = BLEDevice::getAdvertising();
    pAdvertising->setScanResponse(true);
    pAdvertising->setMinPreferred(0x06);  // For iOS compatibility
    pAdvertising->start();

    logger.log("BLE initialized, advertising as '%s'", PROJECT_NAME);
}

void initWiFi() {
    wifi.begin();

    // Try to connect with stored credentials
    if (wifi.hasCredentials()) {
        logger.log("Found stored WiFi credentials for '%s', attempting connection...", wifi.getSSID().c_str());
        if (wifi.connect() == 0) {
            logger.log("WiFi connected: %s", WiFi.localIP().toString().c_str());
        } else {
            logger.log("WiFi connection failed, use BLE to configure");
        }
    } else {
        logger.log("No stored WiFi credentials, use BLE to configure");
    }
}

void setup() {
    Serial.begin(115200);
    delay(1000);

    Serial.println();
    Serial.println("================================");
    Serial.printf("{{ PROJECT_NAME_PASCAL }} %s\n", FIRMWARE_VERSION);
    Serial.println("================================");
    Serial.println();

    // Initialize components
    initSDCard();
    initWiFi();
    initBLE();

    logger.log("Setup complete!");
}

void loop() {
    // Handle BLE services (deferred command processing)
    wifiBleService.handle();
    otaBleService.handle();

    // Handle BLE connection state changes
    if (deviceConnected && !oldDeviceConnected) {
        // Device just connected
        oldDeviceConnected = deviceConnected;
    }

    if (!deviceConnected && oldDeviceConnected) {
        // Device just disconnected - restart advertising
        delay(500);
        BLEDevice::getAdvertising()->start();
        oldDeviceConnected = deviceConnected;
    }

    // Your application logic here
    // ...

    delay(100);
}
