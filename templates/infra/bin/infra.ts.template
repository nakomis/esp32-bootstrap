#!/usr/bin/env node
import * as cdk from 'aws-cdk-lib';
import { IoTDeviceStack } from '../lib/iot-device-stack';

const app = new cdk.App();

const env = {
    account: process.env.CDK_DEFAULT_ACCOUNT,
    region: process.env.CDK_DEFAULT_REGION || 'eu-west-2'
};

// Fleet env: from -c fleetEnv=... or NAKOMIS_ENV; defaults to sandbox.
const fleetEnv = (app.node.tryGetContext('fleetEnv')
    ?? process.env.NAKOMIS_ENV
    ?? 'sandbox') as 'sandbox' | 'prod';

new IoTDeviceStack(app, `{{ PROJECT_NAME_PASCAL }}IoTStack-${fleetEnv}`, {
    env,
    fleetEnv,
});
